rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Pasta única compartilhada: qualquer usuário autenticado (com
    // qualquer login) lê e escreve os mesmos arquivos.
    match /dados-compartilhados/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
